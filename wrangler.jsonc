{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wfm-trade-analyzer",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "frameanalytics_auth",
      "database_name": "frameanalytics-auth",
      "database_id": "0b6a775b-61fc-4e91-a18b-6829132c74c1"
    }
  ]
}
